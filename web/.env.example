# Copy to .env.local. Never commit the copy - the .gitignore excludes .env*.

# Sign-in mode for the BFF.
#   mock  - /api/auth/login writes a session for a fixture operator and redirects
#           to /dashboard. Local UI work only; the .NET API has no auth yet.
#   oidc  - Authorization Code + PKCE against Zitadel (lands with the Zitadel
#           compose service; the route returns 501 until then).
AUTH_MODE=mock

# 32-byte key for the AES-256-GCM session cookie, base64url encoded.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Left empty in development, the BFF derives a fixed dev-only key and logs a warning.
SESSION_SECRET=

# Base URL of AuthzPlane.Api. Unset = serve fixtures from src/server/fixtures.
AUTHZPLANE_API_URL=

# Zitadel settings, used only when AUTH_MODE=oidc.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
